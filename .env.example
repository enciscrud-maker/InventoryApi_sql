# Salin menjadi .env lalu ubah nilainya.
# Hindari karakter ; dan = di password (dipakai di connection string).
SA_PASSWORD=Your_strong_Passw0rd
JWT_KEY=ganti-dengan-kunci-acak-minimal-32-karakter-panjang
ADMIN_PASSWORD=Admin#12345
# Port SQL Server di host. 1434 dipilih agar tidak bentrok dengan SQL Server native di 1433.
SQL_HOST_PORT=1434
API_HOST_PORT=8080
